      "Bash(cd \"C:\\\\InfoBhoomi\\\\infoBhoomi-frontedend-div2\" && node -e \"\nconst fs = require\\('fs'\\);\nconst {execSync} = require\\('child_process'\\);\n// Find files that implement OnDestroy but have no ngOnDestroy body\nconst files = execSync\\('grep -rl \\\\\"implements.*OnDestroy\\\\\" src/', {encoding:'utf8'}\\).trim\\(\\).split\\('\\\\n'\\).filter\\(Boolean\\);\nfiles.forEach\\(f => {\n  const c = fs.readFileSync\\(f,'utf8'\\);\n  if \\(!c.includes\\('ngOnDestroy'\\)\\) console.log\\(f\\);\n}\\);\n\" 2>&1)",
      "Bash(cd \"C:\\\\InfoBhoomi\\\\infoBhoomi-frontedend-div2\" && node -e \"\nconst fs = require\\('fs'\\);\nconst files = [\n  'src/app/components/dialogs/add-right-holder/add-right-holder.component.ts',\n  'src/app/components/side-panel/side-panel.component.ts'\n];\nfiles.forEach\\(f => {\n  let src = fs.readFileSync\\(f, 'utf8'\\);\n  // Remove 'OnDestroy' from implements clause\n  src = src.replace\\(/, OnDestroy\\\\b/g, ''\\).replace\\(/\\\\bOnDestroy,\\\\s*/g, ''\\).replace\\(/\\\\bOnDestroy\\\\b/g, ''\\);\n  // Remove now-unused OnDestroy from @angular/core import\n  src = src.replace\\(/\\(import\\\\s*\\\\{\\)\\([\\\\s\\\\S]*?\\)\\(\\\\}\\\\s*from\\\\s*'@angular\\\\/core'\\)/m, \\(_, open, symbols, close\\) => {\n    const cleaned = symbols.split\\(','\\).map\\(s=>s.trim\\(\\)\\).filter\\(s => s && s !== 'OnDestroy'\\).join\\(', '\\);\n    return open + cleaned + close;\n  }\\);\n  fs.writeFileSync\\(f, src, 'utf8'\\);\n  console.log\\('✓', f\\);\n}\\);\n\" 2>&1)",
