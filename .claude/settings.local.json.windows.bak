      "Bash(cd /c/InfoBhoomi/InfoBhoomi_Backend_dev2 && source venv/Scripts/activate && python manage.py shell -c \"\nfrom user.models import Survey_Rep_DATA_Model, LA_LS_Land_Unit_Model, Assessment_Model\nfrom django.db.models import Min, Max, Avg, Count\n\nprint\\('=== Area range \\(m2\\) ==='\\)\nagg = Survey_Rep_DATA_Model.objects.filter\\(layer_id__in=[1,6], status=True\\).aggregate\\(\n    mn=Min\\('area'\\), mx=Max\\('area'\\), avg=Avg\\('area'\\)\\)\nprint\\(f'  min={float\\(agg[\\\\\"mn\\\\\"]\\):.1f}  max={float\\(agg[\\\\\"mx\\\\\"]\\):.1f}  avg={float\\(agg[\\\\\"avg\\\\\"]\\):.1f}'\\)\n\nprint\\(\\)\nprint\\('=== Market value range \\(LKR\\) ==='\\)\nagg2 = Assessment_Model.objects.aggregate\\(mn=Min\\('market_value'\\), mx=Max\\('market_value'\\), avg=Avg\\('market_value'\\)\\)\nprint\\(f'  min={float\\(agg2[\\\\\"mn\\\\\"]\\):,.0f}  max={float\\(agg2[\\\\\"mx\\\\\"]\\):,.0f}  avg={float\\(agg2[\\\\\"avg\\\\\"]\\):,.0f}'\\)\n\nprint\\(\\)\nprint\\('=== Assessment value range \\(LKR\\) ==='\\)\nagg3 = Assessment_Model.objects.aggregate\\(mn=Min\\('assessment_annual_value'\\), mx=Max\\('assessment_annual_value'\\)\\)\nprint\\(f'  min={float\\(agg3[\\\\\"mn\\\\\"]\\):,.0f}  max={float\\(agg3[\\\\\"mx\\\\\"]\\):,.0f}'\\)\n\nprint\\(\\)\nprint\\('=== Sample land units ==='\\)\nfor lu in LA_LS_Land_Unit_Model.objects.all\\(\\)[:5]:\n    print\\(f'  su_id={lu.su_id_id}  type={lu.sl_land_type!r:15}  name={lu.land_name!r}  road={lu.access_road}'\\)\n\nprint\\(\\)\nprint\\('=== land_name filled ==='\\)\nfilled = LA_LS_Land_Unit_Model.objects.exclude\\(land_name__isnull=True\\).exclude\\(land_name=''\\).count\\(\\)\ntotal  = LA_LS_Land_Unit_Model.objects.count\\(\\)\nprint\\(f'  {filled}/{total} have land_name'\\)\n\nprint\\(\\)\nprint\\('=== Query test: Residential parcels ==='\\)\nfrom user.models import LA_LS_Land_Unit_Model as LU\nres = LU.objects.filter\\(sl_land_type__icontains='Residential'\\).count\\(\\)\nprint\\(f'  Residential matches: {res}'\\)\n\nprint\\(\\)\nprint\\('=== Query test: overdue tax ==='\\)\noverdue = Assessment_Model.objects.filter\\(tax_status='overdue'\\).count\\(\\)\nprint\\(f'  Overdue tax records: {overdue}'\\)\n\nprint\\(\\)\nprint\\('=== Query test: large parcels >500 m2 ==='\\)\nlarge = Survey_Rep_DATA_Model.objects.filter\\(layer_id__in=[1,6], status=True, area__gte=500\\).count\\(\\)\nprint\\(f'  Parcels >= 500 m2: {large}'\\)\n\" 2>&1)",
