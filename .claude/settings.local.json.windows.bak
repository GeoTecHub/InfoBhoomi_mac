      "Bash(cd /c/InfoBhoomi/InfoBhoomi_Backend_dev2 && source venv/Scripts/activate && python - << 'PYEOF'\nimport django, os, random\nfrom datetime import date\n\nos.environ.setdefault\\('DJANGO_SETTINGS_MODULE', 'infobhoomi.settings'\\)\ndjango.setup\\(\\)\n\nfrom django.db import transaction\nfrom django.contrib.gis.geos import GEOSGeometry, Polygon\nfrom user.models import \\(\n    Survey_Rep_DATA_Model, LA_Spatial_Unit_Model,\n    LA_LS_Build_Unit_Model, LA_LS_MyLayer_Polygon_Unit_Model\n\\)\n\n# ── Seed data pools ─────────────────────────────────────────────────────────\nBUILDING_NAMES = [\n    \"Sampath House\", \"Nuwara Villa\", \"Ella View Residence\", \"Badulla Home\",\n    \"Hill Top Building\", \"Sunrise Cottage\", \"Valley Dwelling\", \"Green Meadow House\",\n    \"Tea Garden Residence\", \"Uva Province Building\", \"Bandarawela Heights\",\n    \"Kebillewela Lodge\", \"Ambegoda House\", \"Watagamuwa Villa\", \"Bindunuwewa Residence\",\n    \"Makulella Building\", \"Kinigama Cottage\", \"Obadella Home\", \"Egodagama House\",\n    \"Bambaragama Villa\", \"Mahaulpatha Residence\", \"Darahitawanagoda Building\",\n    \"Doolgolla House\", \"Creig Watta Villa\", \"Liyangahawela Home\",\n    \"Ambadandegama Residence\", \"Beddearawa Building\", \"Thanthiriya Lodge\",\n    \"Udaperuwa House\", \"Weheragalathenna Villa\", \"Inikambedda Residence\",\n    \"Karagahawela House\", \"Beddekumbura Home\", \"Diganathenna Building\",\n    \"Ettalapitiya Villa\", \"Kirioruwa Residence\", \"Icelab Watta House\",\n    \"Konthahela Lodge\", \"Mathetilla Building\", \"Gediyaroda Villa\",\n]\n\nSTRUCTURE_TYPES  = ['CONC_REINF', 'MASONRY', 'STEEL_FRM', 'TIMBER', 'COMPOSITE']\nCONDITIONS       = ['EXCELLENT', 'GOOD', 'FAIR', 'POOR']\nROOF_TYPES       = ['FLAT', 'GABLE', 'HIP', 'SHED', 'MANSARD']\nWALL_TYPES       = ['BRICK', 'CONCRETE', 'WOOD', 'STONE', 'STEEL']\nUSE_TYPES        = ['Residential', 'Commercial', 'Mixed Use', 'Institutional', 'Agricultural']\nUSE_SUB_TYPES    = ['Single Family', 'Multi Family', 'Office', 'Shop', 'Warehouse', 'School']\nSURFACE_RELATIONS = ['ON_GROUND', 'ABOVE_GROUND', 'BELOW_GROUND']\nPROP_TYPES       = ['Freehold', 'Leasehold', 'State Land', 'Crown Land']\n\nrandom.seed\\(42\\)   # reproducible\n\n# ── Pick 40 Bandarawela land parcels spread across GNDs ─────────────────────\nbandarawela_gids = list\\(range\\(12445, 12480\\)\\)\nexisting_refs = set\\(\n    Survey_Rep_DATA_Model.objects.filter\\(layer_id__in=[3, 12]\\)\n    .values_list\\('ref_id', flat=True\\)\n\\)\n\navailable_parcels = list\\(\n    Survey_Rep_DATA_Model.objects\n    .filter\\(gnd_id__in=bandarawela_gids, geom_type__in=['polygon','multipolygon'],\n            org_id=2, status=True\\)\n    .exclude\\(su_id__in=[r for r in existing_refs if r is not None]\\)\n    .order_by\\('gnd_id', 'id'\\)\n    .values\\('id', 'su_id_id', 'gnd_id', 'geom', 'org_id'\\)\n\\)\n\n# Spread evenly: pick ~1-2 per GND then fill up to 40\ngnd_buckets: dict[int, list] = {}\nfor p in available_parcels:\n    gnd_buckets.setdefault\\(p['gnd_id'], []\\).append\\(p\\)\n\nselected = []\n# First pass: 1 per GND\nfor gid in sorted\\(gnd_buckets.keys\\(\\)\\):\n    if gnd_buckets[gid]:\n        selected.append\\(gnd_buckets[gid].pop\\(0\\)\\)\n    if len\\(selected\\) >= 40:\n        break\n\n# Second pass: fill remaining slots\nif len\\(selected\\) < 40:\n    remainder = [p for bucket in gnd_buckets.values\\(\\) for p in bucket]\n    random.shuffle\\(remainder\\)\n    selected.extend\\(remainder[: 40 - len\\(selected\\)]\\)\n\nselected = selected[:40]\nprint\\(f\"Selected {len\\(selected\\)} land parcels across \"\n      f\"{len\\({p['gnd_id'] for p in selected}\\)} GNDs\"\\)\n\n# ── Helper: create a small rectangular building footprint inside a parcel ───\ndef building_polygon_inside\\(parcel_geom: GEOSGeometry\\) -> Polygon:\n    \"\"\"Return a ~35% sized rectangle centred on the parcel centroid.\"\"\"\n    cx, cy = parcel_geom.centroid.x, parcel_geom.centroid.y\n    xmin, ymin, xmax, ymax = parcel_geom.extent\n    hw = \\(xmax - xmin\\) * 0.18   # half-width  \\(~35% of parcel\\)\n    hh = \\(ymax - ymin\\) * 0.18   # half-height\n    coords = [\n        \\(cx - hw, cy - hh\\),\n        \\(cx + hw, cy - hh\\),\n        \\(cx + hw, cy + hh\\),\n        \\(cx - hw, cy + hh\\),\n        \\(cx - hw, cy - hh\\),     # close ring\n    ]\n    poly = Polygon\\(coords, srid=4326\\)\n    return poly\n\n# ── Determine next available su_id ──────────────────────────────────────────\nnext_su_id = LA_Spatial_Unit_Model.objects.order_by\\('-su_id'\\).first\\(\\).su_id + 1\n\n# ── Create records ───────────────────────────────────────────────────────────\ncreated_count = 0\nwith transaction.atomic\\(\\):\n    for i, parcel in enumerate\\(selected\\):\n        name          = BUILDING_NAMES[i % len\\(BUILDING_NAMES\\)]\n        floors        = random.randint\\(1, 4\\)\n        condition     = random.choice\\(CONDITIONS\\)\n        structure     = random.choice\\(STRUCTURE_TYPES\\)\n        roof          = random.choice\\(ROOF_TYPES\\)\n        wall          = random.choice\\(WALL_TYPES\\)\n        use_type      = random.choice\\(USE_TYPES\\)\n        use_sub_type  = random.choice\\(USE_SUB_TYPES\\)\n        surface_rel   = 'ON_GROUND'\n        height_m      = round\\(floors * 3.0 + random.uniform\\(-0.5, 0.5\\), 2\\)\n        prop_type     = random.choice\\(PROP_TYPES\\)\n        house_no      = f\"BW-{1000 + i}\"\n        reg_year      = random.randint\\(1990, 2022\\)\n        reg_date      = date\\(reg_year, random.randint\\(1, 12\\), random.randint\\(1, 28\\)\\)\n\n        su_id_val     = next_su_id + i\n\n        # 1. LA_Spatial_Unit_Model\n        su_obj = LA_Spatial_Unit_Model.objects.create\\(\n            su_id      = su_id_val,\n            ladm_value = 'BuildingUnit',\n            label      = f'BU-{su_id_val}',\n            status     = True,\n        \\)\n\n        # 2. Survey_Rep_DATA_Model \\(building layer = 3\\)\n        parcel_geom = GEOSGeometry\\(parcel['geom']\\)\n        bld_geom    = building_polygon_inside\\(parcel_geom\\)\n\n        sr_obj = Survey_Rep_DATA_Model.objects.create\\(\n            su_id     = su_obj,\n            user_id   = 3,            # admin_bw\n            layer_id  = 3,            # building layer\n            org_id    = parcel['org_id'],\n            gnd_id    = parcel['gnd_id'],\n            geom_type = 'Polygon',\n            geom      = bld_geom,\n            ref_id    = parcel['su_id_id'],   # link to parent land parcel\n            status    = True,\n        \\)\n\n        # 3. LA_LS_Build_Unit_Model\n        LA_LS_Build_Unit_Model.objects.create\\(\n            su_id               = su_obj,\n            building_name       = name,\n            no_floors           = floors,\n            condition           = condition,\n            structure_type      = structure,\n            roof_type           = roof,\n            wall_type           = wall,\n            ext_builduse_type   = use_type,\n            ext_builduse_sub_type = use_sub_type,\n            surface_relation    = surface_rel,\n            hight               = height_m,\n            bld_property_type   = prop_type,\n            house_hold_no       = house_no,\n            registration_date   = reg_date,\n            construction_year   = reg_year,\n            access_road         = 'Yes',\n            status              = True,\n        \\)\n\n        created_count += 1\n        print\\(f\"  [{i+1:02d}] su_id={su_id_val} sr_id={sr_obj.id} \"\n              f\"gnd={parcel['gnd_id']} ref_parcel={parcel['su_id_id']} \"\n              f\"'{name}' {floors}F {condition}\"\\)\n\nprint\\(f\"\\\\nDone. Created {created_count} building units.\"\\)\nPYEOF)",
      "Bash(PGPASSWORD=\"POST@info#box2024\" \"/c/Program Files/PostgreSQL/15/bin/psql\":*)",
      "Bash(cd /c/InfoBhoomi/InfoBhoomi_Backend_dev2 && source venv/Scripts/activate && pip install pyshp==2.3.1 2>&1)",
      "Bash(cd /c/InfoBhoomi/InfoBhoomi_Backend_dev2 && source venv/Scripts/activate && python manage.py shell -c \"\nfrom user.models import Survey_Rep_DATA_Model, LA_Spatial_Unit_Model, LA_LS_Land_Unit_Model, Assessment_Model\nfrom django.contrib.auth import get_user_model\nUser = get_user_model\\(\\)\n\n# Count existing records\nsurveys = Survey_Rep_DATA_Model.objects.filter\\(layer_id__in=[1,6], status=True\\)\nprint\\('Survey records \\(land layers 1,6\\):', surveys.count\\(\\)\\)\nprint\\('LA_Spatial_Unit records:', LA_Spatial_Unit_Model.objects.count\\(\\)\\)\nprint\\('Land Unit records:', LA_LS_Land_Unit_Model.objects.count\\(\\)\\)\nprint\\('Assessment records:', Assessment_Model.objects.count\\(\\)\\)\n\n# Show sample org_ids and user_ids in use\nif surveys.exists\\(\\):\n    sample = surveys.values\\('org_id','user_id','layer_id','su_id_id'\\).first\\(\\)\n    print\\('Sample survey row:', sample\\)\n    # show su_id distribution\n    org_ids = list\\(surveys.values_list\\('org_id', flat=True\\).distinct\\(\\)\\)\n    print\\('Org IDs in use:', org_ids\\)\n    layers = list\\(surveys.values_list\\('layer_id', flat=True\\).distinct\\(\\)\\)\n    print\\('Layer IDs in use:', layers\\)\n\n# Show existing land units\nlu_count = LA_LS_Land_Unit_Model.objects.count\\(\\)\nass_count = Assessment_Model.objects.count\\(\\)\nif lu_count > 0:\n    sample_lu = LA_LS_Land_Unit_Model.objects.values\\(\\).first\\(\\)\n    print\\('Sample land_unit:', sample_lu\\)\nif ass_count > 0:\n    sample_ass = Assessment_Model.objects.values\\(\\).first\\(\\)\n    print\\('Sample assessment:', sample_ass\\)\n\" 2>&1)",
      "Bash(cd /c/InfoBhoomi/InfoBhoomi_Backend_dev2 && source venv/Scripts/activate && python manage.py shell -c \"\nfrom user.models import Survey_Rep_DATA_Model, LA_Spatial_Unit_Model, LA_LS_Land_Unit_Model, Assessment_Model\nfrom django.db.models import Count, Min, Max, Avg\n\n# Land unit diversity\nprint\\('=== sl_land_type distribution ==='\\)\nfor row in LA_LS_Land_Unit_Model.objects.values\\('sl_land_type'\\).annotate\\(n=Count\\('id'\\)\\).order_by\\('-n'\\)[:15]:\n    print\\(f'  {row[\\\\\"sl_land_type\\\\\"]!r}: {row[\\\\\"n\\\\\"]}'\\)\n\nprint\\(\\)\nprint\\('=== land_name null/blank ==='\\)\nblank = LA_LS_Land_Unit_Model.objects.filter\\(land_name__isnull=True\\).count\\(\\)\nempty = LA_LS_Land_Unit_Model.objects.filter\\(land_name=''\\).count\\(\\)\nfilled = LA_LS_Land_Unit_Model.objects.exclude\\(land_name__isnull=True\\).exclude\\(land_name=''\\).count\\(\\)\nprint\\(f'  null: {blank}, empty: {empty}, filled: {filled}'\\)\n\nprint\\(\\)\nprint\\('=== access_road values ==='\\)\nfor row in LA_LS_Land_Unit_Model.objects.values\\('access_road'\\).annotate\\(n=Count\\('id'\\)\\):\n    print\\(f'  {row[\\\\\"access_road\\\\\"]!r}: {row[\\\\\"n\\\\\"]}'\\)\n\nprint\\(\\)\nprint\\('=== tax_status distribution ==='\\)\nfor row in Assessment_Model.objects.values\\('tax_status'\\).annotate\\(n=Count\\('id'\\)\\).order_by\\('-n'\\):\n    print\\(f'  {row[\\\\\"tax_status\\\\\"]!r}: {row[\\\\\"n\\\\\"]}'\\)\n\nprint\\(\\)\nprint\\('=== area range \\(survey records\\) ==='\\)\nagg = Survey_Rep_DATA_Model.objects.filter\\(layer_id__in=[1,6], status=True\\).aggregate\\(\n    mn=Min\\('area'\\), mx=Max\\('area'\\), avg=Avg\\('area'\\)\n\\)\nprint\\(f'  min={agg[\\\\\"mn\\\\\"]}, max={agg[\\\\\"mx\\\\\"]}, avg={agg[\\\\\"avg\\\\\"]:.2f}'\\)\n\nprint\\(\\)\nprint\\('=== assessment values range ==='\\)\nagg2 = Assessment_Model.objects.aggregate\\(\n    mn_av=Min\\('assessment_annual_value'\\), mx_av=Max\\('assessment_annual_value'\\),\n    mn_mv=Min\\('market_value'\\), mx_mv=Max\\('market_value'\\),\n    null_mv=Count\\('id', filter=__import__\\('django.db.models', fromlist=['Q']\\).Q\\(market_value__isnull=True\\)\\),\n\\)\nprint\\(f'  assessment_annual_value: {agg2[\\\\\"mn_av\\\\\"]} – {agg2[\\\\\"mx_av\\\\\"]}'\\)\nprint\\(f'  market_value: {agg2[\\\\\"mn_mv\\\\\"]} – {agg2[\\\\\"mx_mv\\\\\"]} \\(null={agg2[\\\\\"null_mv\\\\\"]}\\)'\\)\n\nprint\\(\\)\nprint\\('=== local_auth sample ==='\\)\nfor row in LA_LS_Land_Unit_Model.objects.values\\('local_auth'\\).annotate\\(n=Count\\('id'\\)\\).order_by\\('-n'\\)[:8]:\n    print\\(f'  {row[\\\\\"local_auth\\\\\"]!r}: {row[\\\\\"n\\\\\"]}'\\)\n\" 2>&1)",
      "Bash(cd /c/InfoBhoomi/InfoBhoomi_Backend_dev2 && source venv/Scripts/activate && python manage.py shell -c \"\nfrom django.db import connection\n\nwith connection.cursor\\(\\) as cur:\n    # Check SRID of stored geometries\n    cur.execute\\(\\\\\"\\\\\"\\\\\"\n        SELECT ST_SRID\\(geom\\), count\\(*\\) \n        FROM survey_rep \n        WHERE layer_id IN \\(1,6\\) AND status=true AND geom IS NOT NULL\n        GROUP BY ST_SRID\\(geom\\)\n        LIMIT 5\n    \\\\\"\\\\\"\\\\\"\\)\n    print\\('SRID distribution:', cur.fetchall\\(\\)\\)\n    \n    # Sample geometry extent\n    cur.execute\\(\\\\\"\\\\\"\\\\\"\n        SELECT ST_AsText\\(ST_Centroid\\(geom\\)\\) as centroid, area\n        FROM survey_rep \n        WHERE layer_id IN \\(1,6\\) AND status=true AND geom IS NOT NULL\n        LIMIT 3\n    \\\\\"\\\\\"\\\\\"\\)\n    for row in cur.fetchall\\(\\):\n        print\\('centroid:', row[0], 'area:', row[1]\\)\n\n    # Try computing area\n    cur.execute\\(\\\\\"\\\\\"\\\\\"\n        SELECT ST_Area\\(ST_Transform\\(geom::geometry, 32644\\)\\) as area_m2\n        FROM survey_rep \n        WHERE layer_id IN \\(1,6\\) AND status=true AND geom IS NOT NULL\n        LIMIT 3\n    \\\\\"\\\\\"\\\\\"\\)\n    print\\('Computed areas \\(m2\\):', [r[0] for r in cur.fetchall\\(\\)]\\)\n\" 2>&1)",
      "Bash(cd /c/InfoBhoomi/InfoBhoomi_Backend_dev2 && source venv/Scripts/activate && python manage.py seed_land_data 2>&122)",
