      "Bash(node -e \"\nconst unzip = require\\('C:/Infobhoomi/infoBhoomi-frontedend-div2/node_modules/but-unzip'\\);\nconsole.log\\(typeof unzip, Object.keys\\(unzip\\)\\);\n\" 2>&1)",
      "Bash(node -e \"\nconst fs = require\\('fs'\\);\n// Verify but-unzip exists\nconst exists = fs.existsSync\\('C:\\\\\\\\\\\\\\\\Infobhoomi\\\\\\\\\\\\\\\\infoBhoomi-frontedend-div2\\\\\\\\\\\\\\\\node_modules\\\\\\\\\\\\\\\\but-unzip'\\);\nconsole.log\\('but-unzip exists:', exists\\);\nconst pkg = JSON.parse\\(fs.readFileSync\\('C:\\\\\\\\\\\\\\\\Infobhoomi\\\\\\\\\\\\\\\\infoBhoomi-frontedend-div2\\\\\\\\\\\\\\\\node_modules\\\\\\\\\\\\\\\\but-unzip\\\\\\\\\\\\\\\\package.json', 'utf8'\\)\\);\nconsole.log\\('main:', pkg.main\\);\nconsole.log\\('exports:', JSON.stringify\\(pkg.exports\\)\\);\n\" 2>&1)",
      "Bash(cd \"C:/Infobhoomi/infoBhoomi-frontedend-div2\" && node -e \"const u = require\\('but-unzip'\\); console.log\\(typeof u, Object.keys\\(u\\).slice\\(0,5\\)\\)\")",
      "Bash(cd \"C:/Infobhoomi/infoBhoomi-frontedend-div2\" && node -e \"\nconst fs = require\\('fs'\\);\nconst src = fs.readFileSync\\('src/app/components/shared/popups/import-data/import-data.component.ts', 'utf8'\\);\n// Check for removed things\nconst checks = [\n  ['HttpEventType', false],\n  ['Subscription', false],\n  ['uploadSubscription', false],\n  ['IMPORT_RASTER_DATA', false],\n  ['detectProjection', false],\n  ['handleGeoTiffFileUpload', false],\n  ['reprojectGeoJson', false],\n  ['transformGeometry', false],\n  // Check new additions\n  ['extractPrjFromZip', true],\n  ['detectCrsFromWkt', true],\n  ['CHUNK_SIZE', true],\n  ['DecompressionStream', true],\n  ['AUTHORITY', true],\n];\nchecks.forEach\\(\\([term, shouldExist]\\) => {\n  const exists = src.includes\\(term\\);\n  const ok = exists === shouldExist;\n  console.log\\(\\(ok ? 'OK' : 'FAIL'\\), term, shouldExist ? '\\(should exist\\)' : '\\(should be gone\\)'\\);\n}\\);\n\")",
      "Bash(cd \"C:/Infobhoomi\" && node -e \"\nconst fs = require\\('fs'\\);\n\nasync function extractPrjFromZip\\(arrayBuffer\\) {\n  const bytes = new Uint8Array\\(arrayBuffer\\);\n  const view = new DataView\\(arrayBuffer\\);\n\n  // Find EOCD\n  let eocdOffset = -1;\n  const maxSearch = Math.max\\(0, bytes.length - 65558\\);\n  for \\(let i = bytes.length - 22; i >= maxSearch; i--\\) {\n    if \\(view.getUint32\\(i, true\\) === 0x06054b50\\) { eocdOffset = i; break; }\n  }\n  if \\(eocdOffset === -1\\) return null;\n\n  const cdCount = view.getUint16\\(eocdOffset + 10, true\\);\n  const cdOffset = view.getUint32\\(eocdOffset + 16, true\\);\n\n  let offset = cdOffset;\n  for \\(let i = 0; i < cdCount; i++\\) {\n    if \\(view.getUint32\\(offset, true\\) !== 0x02014b50\\) break;\n\n    const compressionMethod = view.getUint16\\(offset + 10, true\\);\n    const compressedSize = view.getUint32\\(offset + 20, true\\);\n    const cdFileNameLen = view.getUint16\\(offset + 28, true\\);\n    const cdExtraLen = view.getUint16\\(offset + 30, true\\);\n    const cdCommentLen = view.getUint16\\(offset + 32, true\\);\n    const localHeaderOffset = view.getUint32\\(offset + 42, true\\);\n    const fileName = new TextDecoder\\(\\).decode\\(bytes.slice\\(offset + 46, offset + 46 + cdFileNameLen\\)\\);\n\n    console.log\\('Found entry:', fileName, 'method:', compressionMethod, 'compressedSize:', compressedSize\\);\n\n    if \\(fileName.toLowerCase\\(\\).endsWith\\('.prj'\\)\\) {\n      const localFileNameLen = view.getUint16\\(localHeaderOffset + 26, true\\);\n      const localExtraLen = view.getUint16\\(localHeaderOffset + 28, true\\);\n      const dataOffset = localHeaderOffset + 30 + localFileNameLen + localExtraLen;\n\n      const compressedData = bytes.slice\\(dataOffset, dataOffset + compressedSize\\);\n      console.log\\('PRJ compressedData length:', compressedData.length, 'method:', compressionMethod\\);\n\n      if \\(compressionMethod === 0\\) {\n        return new TextDecoder\\(\\).decode\\(compressedData\\);\n      }\n      // method 8 = deflate \\(Node.js zlib\\)\n      if \\(compressionMethod === 8\\) {\n        const zlib = require\\('zlib'\\);\n        return new Promise\\(\\(res, rej\\) => {\n          zlib.inflateRaw\\(Buffer.from\\(compressedData\\), \\(err, buf\\) => {\n            if \\(err\\) rej\\(err\\); else res\\(buf.toString\\('utf8'\\)\\);\n          }\\);\n        }\\);\n      }\n    }\n    offset += 46 + cdFileNameLen + cdExtraLen + cdCommentLen;\n  }\n  return null;\n}\n\nconst buf = fs.readFileSync\\('BWMC_Parcels.zip'\\);\nconst ab = buf.buffer.slice\\(buf.byteOffset, buf.byteOffset + buf.byteLength\\);\nextractPrjFromZip\\(ab\\).then\\(prj => {\n  console.log\\('PRJ content:', prj\\);\n  // Test AUTHORITY pattern\n  const auth = prj && prj.match\\(/AUTHORITY\\\\\\\\[\\\\\"EPSG\\\\\",\\\\\"\\(\\\\\\\\d+\\)\\\\\"\\\\\\\\]/i\\);\n  console.log\\('AUTHORITY match:', auth ? auth[1] : 'none'\\);\n  // Test name fallback\n  const wgs84 = prj && /GCS_WGS_1984|WGS_1984|WGS 84/i.test\\(prj\\);\n  console.log\\('WGS84 name match:', wgs84\\);\n}\\).catch\\(e => console.error\\('Error:', e.message\\)\\);\n\" 2>&1)",
      "Bash(cd \"C:/Infobhoomi/infoBhoomi-frontedend-div2\" && node -e \"\nconst fs = require\\('fs'\\);\nconst src = fs.readFileSync\\('src/app/components/shared/popups/import-data/import-data.component.ts', 'utf8'\\);\nconst checks = [\n  ['drawService', false],\n  ['DrawService', false],\n  ['OLPolygon', false],\n  ['OLPoint', false],\n  ['OLLineString', false],\n  ['stageAddition', false],\n  ['findParentGnd', false],\n  ['stageBulkAddition', true],\n  ['CHUNK_SIZE = 200', true],\n  ['convertFeatureToFeatureData', true],\n];\nchecks.forEach\\(\\([term, should]\\) => {\n  const found = src.includes\\(term\\);\n  console.log\\(found === should ? 'OK' : 'FAIL', term\\);\n}\\);\n\" 2>&1)",
