# InfoBhoomi Agent System — Environment Variables
# ─────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── InfoBhoomi API ───────────────────────────────
# Option A (preferred): use your DRF token directly
IB_TOKEN=

# Option B: let the agent log in with credentials
IB_USERNAME=
IB_PASSWORD=

# Base URL (change only if running locally)
IB_BASE_URL=https://infobhoomiback.geoinfobox.com/api/user

# Layer ID for geometry tests (0 = auto-discover from your layers)
IB_LAYER_ID=0

# ── Anthropic Claude API ─────────────────────────
# Required only for the Research Agent (AI-powered fix suggestions)
# Get your key from: https://console.anthropic.com
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AGENT_AI_PROVIDER=local

# Agent QA & Debug Control Center
IB_AGENT_ENVIRONMENT=development
IB_AGENT_ALLOW_DESTRUCTIVE=false
IB_AGENT_TEST_TAG=[AGENT-QA]
IB_AGENT_DASHBOARD_HOST=127.0.0.1
IB_AGENT_DASHBOARD_PORT=8765

# Optional read-only DB verification. Leave blank to skip DB checks.
IB_DATABASE_URL=
IB_DB_HOST=
IB_DB_PORT=5432
IB_DB_NAME=
IB_DB_USER=
IB_DB_PASSWORD=

# ── Self-Healing Pipeline (P0/P1) ────────────────────
# Override only if your repo layout differs from the defaults.
IB_AGENT_FE_ROOT=
IB_AGENT_BE_ROOT=

# Cap evidence captured into memory/ledger files (bytes).
IB_AGENT_EVIDENCE_MAX_BYTES=4096

# Fallback LLM if the user dismisses the picker modal: gemini | claude
IB_AGENT_DEFAULT_LLM=gemini
